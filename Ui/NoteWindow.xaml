<Window x:Class="Notitas.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notita"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        MinWidth="170"
        UseLayoutRounding="True"
        FontFamily="{StaticResource TextFont}"
        FontSize="13.5"
        Foreground="{StaticResource Ink}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Header buttons only appear when the note is in use -->
        <Style x:Key="FadeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Opacity" Value="0.8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Opacity" Value="0.8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PinButton" TargetType="Button" BasedOn="{StaticResource FadeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Topmost}" Value="True">
                    <Setter Property="Opacity" Value="0.8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="Header"
                MouseLeftButtonDown="Header_MouseDown"
                ToolTip="Arrastra para mover · doble clic para plegar"
                ToolTipService.InitialShowDelay="1500">
            <DockPanel LastChildFill="True" Margin="7,0,7,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource FadeButton}" Content="&#xE710;" ToolTip="Nueva nota" Click="New_Click" />
                <Button DockPanel.Dock="Right" Style="{StaticResource FadeButton}" Content="&#xE8BB;" FontSize="10" ToolTip="Guardar en el panel (quita la nota del escritorio)" Click="Stash_Click" />
                <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource FadeButton}" Content="&#xE712;" ToolTip="Color y más opciones" Click="More_Click" />
                <Button x:Name="PinButton" DockPanel.Dock="Right" Style="{StaticResource PinButton}" Click="Pin_Click" />
                <TextBlock x:Name="CollapsedLabel"
                           Text="{Binding DisplayTitle}"
                           FontWeight="SemiBold"
                           FontSize="12.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="4,0"
                           IsHitTestVisible="False"
                           Visibility="Collapsed" />
            </DockPanel>
        </Border>

        <Grid x:Name="Editor" Grid.Row="1" Margin="13,2,5,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="TitleBox"
                     Style="{StaticResource PlainBox}"
                     Tag="Título"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Margin="0,0,8,5"
                     PreviewKeyDown="TitleBox_PreviewKeyDown" />
            <TextBox x:Name="BodyBox"
                     Grid.Row="1"
                     Style="{StaticResource PlainBox}"
                     Tag="Escribe algo…"
                     Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="0,0,8,0" />
        </Grid>

        <WrapPanel x:Name="TagsHost" Grid.Row="2" Margin="11,2,11,9">
            <TextBox x:Name="TagBox"
                     Style="{StaticResource PlainBox}"
                     Tag="+ tag"
                     FontSize="12"
                     MinWidth="48"
                     MaxWidth="150"
                     Margin="3,2,0,2"
                     VerticalAlignment="Center"
                     PreviewKeyDown="TagBox_PreviewKeyDown"
                     TextChanged="TagBox_TextChanged"
                     LostKeyboardFocus="TagBox_LostFocus" />
        </WrapPanel>

        <TextBlock x:Name="Cat"
                   Grid.Row="2"
                   Text="=^.^="
                   FontSize="11"
                   Opacity="0.45"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,11,7"
                   IsHitTestVisible="False"
                   Visibility="Collapsed" />

        <Popup x:Name="MorePopup"
               PlacementTarget="{Binding ElementName=MoreButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{StaticResource PopupCard}" Width="196">
                <StackPanel>
                    <ItemsControl x:Name="Swatches" Margin="4,3,4,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="Swatch_Click" ToolTip="{Binding Name}" Focusable="False" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Dot"
                                                    Width="20"
                                                    Height="20"
                                                    Margin="0,0,4,0"
                                                    CornerRadius="10"
                                                    Background="{Binding Band}"
                                                    BorderBrush="#22000000"
                                                    BorderThickness="1" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource Ink}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource MenuRow}" Content="Plegar o desplegar" Click="Collapse_Click" />
                    <Button Style="{StaticResource MenuRow}" Content="Abrir panel de notas" Click="Panel_Click" />
                    <Button Style="{StaticResource MenuRow}" Content="Enviar a la papelera" Click="Trash_Click" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="TagPopup"
               PlacementTarget="{Binding ElementName=TagBox}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True">
            <Border Style="{StaticResource PopupCard}" MinWidth="130" Padding="4">
                <ListBox x:Name="TagSuggestions"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="12.5"
                         Focusable="False"
                         PreviewMouseLeftButtonUp="TagSuggestions_Click" />
            </Border>
        </Popup>
    </Grid>
</Window>
